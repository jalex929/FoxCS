# FoxCS on-submission grading worker. Install with the steps in README.md.
# NOT ENABLED YET: see "Before this goes live" in README.md.

[Unit]
Description=FoxCS grading worker (deterministic checks, AI review on the Claude subscription)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=foxcs-grader
Group=foxcs-queue
WorkingDirectory=/opt/foxcs/portfolio-showcase
# CLAUDE_CODE_OAUTH_TOKEN=... from `claude setup-token` (a subscription token, not an API key). Mode 600, owned by root.
EnvironmentFile=/etc/foxcs/claude-subscription.env
ExecStart=/usr/bin/python3 grader/review_worker.py \
    --queue /srv/foxcs-queue \
    --exercises /opt/foxcs/portfolio-showcase/grader/exercises \
    --rubrics /opt/foxcs/portfolio-showcase/grader/rubrics \
    --submissions-root /srv/foxcs-queue/files \
    --watch 30
Restart=on-failure
RestartSec=60
# Exit 2 means Claude Code is not on a subscription. Restarting would not fix
# that, and must never turn into billed API calls, so stay stopped.
RestartPreventExitStatus=2

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/srv/foxcs-queue
# Claude Code keeps its own state under the service user's config folder.
Environment=CLAUDE_CONFIG_DIR=/var/lib/foxcs-grader/claude
StateDirectory=foxcs-grader

[Install]
WantedBy=multi-user.target
